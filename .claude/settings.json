{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run check:i18n:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx eslint:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m py_compile:*)",
      "Bash(alembic heads:*)",
      "Bash(alembic history:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag:*)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(alembic stamp:*)",
      "Bash(docker compose down:*)",
      "Bash(docker volume:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(pip install:*)",
      "Bash(pip uninstall:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run:*)",
      "Bash(az:*)",
      "Bash(terraform:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.docker)",
      "Read(**/.env.docker.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.sqlite)",
      "Read(**/infra/backups/**)",
      "Read(**/azure-logs/**)",
      "Read(**/azure-logs-frontend/**)",
      "Read(**/azure-log-full.txt)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.docker)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/infra/backups/**)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(npx supabase:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/workflow-gate.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commands.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
