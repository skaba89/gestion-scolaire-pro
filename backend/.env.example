# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schoolflow
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication: Native JWT (no external identity provider)

# MinIO — LOCAL/TEST only, never used in an Azure REC/PROD environment
# (see docs/STORAGE_ARCHITECTURE.md).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_SECURE=false

# Azure Blob Storage — durable document storage, REQUIRED in Azure
# REC/PROD (ENVIRONMENT=staging/production); see docs/STORAGE_ARCHITECTURE.md.
# Leave both unset locally to keep using MinIO/local disk above.
# AZURE_STORAGE_ACCOUNT_URL=https://stschoolflowdev.blob.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING= (dev/test against an Azurite emulator ONLY — never set in a deployed environment)
# AZURE_STORAGE_CONTAINER=schoolflow-documents

# Application
APP_NAME=Academy Guinéenne API
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-min-32-characters-long-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin bootstrap
ADMIN_DEFAULT_EMAIL=admin@schoolflow.local
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_IN_PRODUCTION
BOOTSTRAP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3002,http://localhost:5173

# Groq AI (required for AI chat and audit analysis features)
# Set your Groq API key (required for AI chat and audit analysis features)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true
